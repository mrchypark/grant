      "id": "rsd_command_tasks.updateRule",
      "operationId": "patch-data.rsd_command_tasks.update",
      "ruleExpression": "@request.auth.email = \"patch-service@conalog.com\" &&\n@request.body.plant:isset = false &&\n@request.body.detected_notification:isset = false &&\n@request.body.command_targets:isset = false &&\n@request.body.cancel_deadline_at:isset = false &&\n(\n  (\n    (\n      (status = \"cancelable\" && cancel_deadline_at <= @now) ||\n      status = \"manual\" ||\n      (status = \"executing\" && claim_deadline_at <= @now)\n    ) &&\n    @request.body.status = \"executing\" &&\n    @request.body.claimed_at:isset = true &&\n    @request.body.claimed_by:isset = true &&\n    @request.body.claim_deadline_at:isset = true &&\n    @request.body.resolved_notification:isset = false\n  ) ||\n  (\n    (status = \"cancelable\" || status = \"manual\") &&\n    @request.body.status = \"canceled\" &&\n    @request.body.canceled_at:isset = true &&\n    @request.body.claim_deadline_at:isset = false &&\n    (\n      @request.body.resolved_notification:isset = false ||\n      @request.body.resolved_notification.id:isset = true\n    )\n  ) ||\n  (\n    status = \"executing\" &&\n    @request.body.status = \"canceled\" &&\n    @request.body.canceled_at:isset = true &&\n    @request.body.canceled_by:isset = false &&\n    @request.body.resolved_notification:isset = false &&\n    @request.body.claim_deadline_at:isset = false\n  ) ||\n  (\n    status = \"executing\" &&\n    (@request.body.status = \"completed\" || @request.body.status = \"failed\") &&\n    @request.body.finished_at:isset = true &&\n    @request.body.claim_deadline_at:isset = false &&\n    @request.body.resolved_notification:isset = false\n  )\n)"
