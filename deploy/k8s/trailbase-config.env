TRAILBASE_ADDRESS=0.0.0.0:4000
TRAILBASE_DATA_DIR=/app/traildepot
TRAILBASE_PUBLIC_DIR=/app/public
TRAILBASE_CUSTOM_LOGIN_ENABLED=false
TRAILBASE_LOGIN_FALLBACK_ENABLED=true
TRAILBASE_DEFAULT_POST_LOGIN_PATH=/app
TRAILBASE_GOOGLE_OAUTH_ENABLED=false
TRAILBASE_GOOGLE_OAUTH_READY=false
# Rollout remains config-driven: keep fallback enabled until the custom page is verified.
# Kakao is wired through TrailBase's generic oidc0 provider slot.
# Do not repoint oidc0 to another issuer without an explicit migration plan.
TRAILBASE_KAKAO_ENABLED=false
TRAILBASE_KAKAO_OIDC_READY=false
TRAILBASE_KAKAO_LINKING_READY=false
TRAILBASE_APPLE_OAUTH_ENABLED=false
TRAILBASE_APPLE_OAUTH_READY=false
LITESTREAM_DB_PATH=/app/traildepot/data/main.db
LITESTREAM_REPLICA_URL=s3://trailbase-backups/main.db
LITESTREAM_ENDPOINT=http://minio.certd.svc.cluster.local:9000
LITESTREAM_REGION=us-east-1
