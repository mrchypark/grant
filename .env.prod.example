MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z

CERTD_MASTER_KEY=replace-with-random-master-key
TRAILBASE_CERTD_INTERNAL_SECRET=replace-with-random-internal-secret
TRAILBASE_DEV=false
TRAILBASE_LOG_RESPONSES=false
CERTD_TRAILBASE_CACHE_TTL_SECONDS=30

CERTD_BOOTSTRAP_USER_ID=conalog-account
CERTD_BOOTSTRAP_USER_NAME=Conalog Account

ARTIFACTS_BUCKET=cert-artifacts
ARTIFACTS_REGION=us-east-1
ARTIFACTS_ENDPOINT=http://minio:9000
ARTIFACTS_PATH_STYLE=true
ARTIFACTS_ACCESS_KEY=minioadmin
ARTIFACTS_SECRET_KEY=minioadmin

CERTD_RUNTIME_MODE=embedded
CERTD_LOCAL_NODE_ROLE=voter
CERTD_READ_CONSISTENCY=local

HQL_NODE_ID=1
HQL_NODES=1 certd:8200 certd:8100\n
HQL_S3_URL=http://minio:9000
HQL_S3_BUCKET=cert-backups
HQL_S3_REGION=us-east-1
HQL_S3_PATH_STYLE=true
HQL_S3_KEY=minioadmin
HQL_S3_SECRET=minioadmin
HQL_LISTEN_ADDR_API=0.0.0.0
HQL_LISTEN_ADDR_RAFT=0.0.0.0
HQL_SECRET_RAFT=replace-with-random-raft-secret
HQL_SECRET_API=replace-with-random-api-secret
ENC_KEYS=replace-with-encryption-key-list
ENC_KEY_ACTIVE=replace-with-active-key-id
