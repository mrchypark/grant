GRANT_MASTER_KEY=replace-with-random-master-key
GRANT_RAUTHY_CLIENT_ID=grant
GRANT_RAUTHY_CLIENT_SECRET=replace-with-rauthy-client-secret
GRANT_RAUTHY_ADMIN_API_KEY='grant-admin$replace-with-rauthy-admin-api-key'
GRANT_RAUTHY_CACHE_TTL_SECONDS=30

GRANT_BOOTSTRAP_USER_ID=conalog-grant
GRANT_BOOTSTRAP_USER_NAME=Conalog Grant

GRANT_RUNTIME_MODE=embedded
GRANT_LOCAL_NODE_ROLE=voter
GRANT_READ_CONSISTENCY=local

HQL_NODE_ID=1
HQL_NODES=1 grant:8100 grant:8200
HQL_S3_URL=https://s3.example.com
HQL_S3_BUCKET=grant-backups
HQL_S3_REGION=us-east-1
HQL_S3_PATH_STYLE=false
HQL_S3_KEY=replace-with-s3-access-key
HQL_S3_SECRET=replace-with-s3-secret-key
HQL_LISTEN_ADDR_API=0.0.0.0
HQL_LISTEN_ADDR_RAFT=0.0.0.0
HQL_SECRET_RAFT=replace-with-random-raft-secret
HQL_SECRET_API=replace-with-random-api-secret
ENC_KEYS=replace-with-encryption-key-list
ENC_KEY_ACTIVE=replace-with-active-key-id
