FROM rust:1.91.1-bookworm AS builder
WORKDIR /workspace
ENV CARGO_BUILD_JOBS=1
ENV CARGO_INCREMENTAL=0
ENV CARGO_PROFILE_DEV_DEBUG=0

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates

RUN cargo build -j 1 -p app

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl libcurl4 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /workspace/target/debug/app /usr/local/bin/certd

ENV CERTD_BIND_ADDR=0.0.0.0:8080
EXPOSE 8080 8100 8200

CMD ["certd"]
